# ============================================================
#  .htaccess – Anna Juranová (annajuranova.cz)
# ============================================================

# ---- Chybová stránka ---------------------------------------
ErrorDocument 404 /404.html

# ---- Cache statických souborů ---------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|avif|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---- Bezpečnostní hlavičky -----------------------------------
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "microphone=(), camera=(), geolocation=()"
</IfModule>

# ---- Přesměrování a čisté URL ---------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> bez www (kanonická doména je annajuranova.cz bez www)
  RewriteCond %{HTTP_HOST} ^www\.annajuranova\.cz$ [NC]
  RewriteRule ^(.*)$ https://annajuranova.cz/$1 [L,R=301]

  # 301 redirect z .html URL na čistou URL (např. /kontakt.html -> /kontakt)
  RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Interní přepis čisté URL na odpovídající .html soubor (pokud existuje)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>
